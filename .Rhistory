factor(sex) +
education + income +
factor(spouse.exist) +
factor(child.exist) +
factor(urban) +
factor(union) +
spouse.precarious +
factor(hourly) +
factor(region) +
factor(industry) +
factor(occupation),
data = df
)
summary(model1)
## regress weight to covariates
model1 <- lm(
